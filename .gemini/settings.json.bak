{
  "general": {
    "previewFeatures": true,
    "defaultApprovalMode": "default"
  },
  "tools": {
    "disableLLMCorrection": false
  },
  "modelConfigs": {
    "customAliases": {
      "cpraio-flash": {
        "extends": "gemini-2.5-flash",
        "modelConfig": {
          "generateContentConfig": {
            "maxOutputTokens": 600
          }
        }
      },
      "cpraio-pro": {
        "extends": "gemini-2.5-pro",
        "modelConfig": {
          "generateContentConfig": {
            "maxOutputTokens": 600
          }
        }
      }
    }
  },
  "mcpServers": {
    "code-review-graph": {
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "cwd": "C:\\Users\\STI01\\Desktop\\Projetos\\Report Preview"
    }
  }
}
