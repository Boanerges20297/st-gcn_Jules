# ====================================
# Hostinger Docker + MemPalace
# Copie para .env na VPS e ajuste apenas os valores reais.
# ====================================

FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
LOG_LEVEL=INFO

APP_PORT=5050
TRAEFIK_HOST=reportpreview.seu-dominio.com

STATIC_EXPORT_OUTPUT_DIR=/app/static_export/data
STATIC_SCREENSHOT_REPO_DIR=/opt/screenshot-report_preview
SCREENSHOT_APP_PATH=./.docker/screenshot-report_preview

SECRET_KEY=troque-por-um-segredo-forte

GOOGLE_API_KEY=preencher
GEMINI_API_KEY=preencher
GEMINI_API_KEYS=preencher

TELEGRAM_BOT_TOKEN=preencher
TELEGRAM_AUTH_SESSION_TTL_SECONDS=28800
TELEGRAM_AUTH_MAX_FAILED_ATTEMPTS=5
TELEGRAM_AUTH_LOCKOUT_SECONDS=900

REPORTPREVIEW_RUNTIME_DIR=/app/outputs/mempalace/chat
MEMPALACE_CONTEXT_PATH=/app/.mempalace.md

ENVIRONMENT=production
DEBUG=false
TESTING=false