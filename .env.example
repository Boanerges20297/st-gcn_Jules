# Configurações de Ambiente - ST-GCN Crime Prediction System
# Copie para .env e preencha com valores reais

# ====================================
# Configurações Flask
# ====================================
FLASK_APP=app.py
FLASK_ENV=production
LOG_LEVEL=INFO

# ====================================
# Banco de Dados (se necessário)
# ====================================
# DATABASE_URL=postgresql://user:password@localhost/st_gcn_db

# ====================================
# Caminhos de Arquivo
# ====================================
MODEL_PATH=./models/stgcn_model_v2.pth
DATA_PATH=./data
LOGS_PATH=./logs
OUTPUT_PATH=./outputs

# ====================================
# Portas de Serviço
# ====================================
APP_PORT=5000
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ====================================
# Redis Cache
# ====================================
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_EXPIRY=3600

# ====================================
# Monitoring - Grafana
# ====================================
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_DOMAIN=localhost:3000

# ====================================
# Monitoring - Prometheus
# ====================================
PROMETHEUS_RETENTION=15d
PROMETHEUS_SCRAPE_INTERVAL=15s

# ====================================
# Logging
# ====================================
LOG_FORMAT=json
LOG_OUTPUT=stdout,file:./logs/app.log
LOG_RETENTION_DAYS=30

# ====================================
# Segurança
# ====================================
SECRET_KEY=seu-secret-key-super-seguro-aqui
API_KEY_ENABLED=false
API_KEY_HEADER=X-API-Key

# ====================================
# CORS (Cross-Origin Resource Sharing)
# ====================================
CORS_ORIGINS=*
CORS_ALLOW_HEADERS=Content-Type,Authorization

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ====================================
# Deployment
# ====================================
ENVIRONMENT=production
VERSION=week5
BUILD_DATE=2026-02-06

# ====================================
# Slack Notifications (CI/CD)
# ====================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#deployments

# ====================================
# External APIs (se necessário)
# ====================================
# OPENAI_API_KEY=sk-xxxxx (para futuro uso em explicações com LLM)
# GOOGLE_API_KEY=xxxx

# ====================================
# Telegram Auth Local
# ====================================
TELEGRAM_AUTH_SESSION_TTL_SECONDS=28800
TELEGRAM_AUTH_MAX_FAILED_ATTEMPTS=5
TELEGRAM_AUTH_LOCKOUT_SECONDS=900

# ====================================
# Debug Mode (apenas desenvolvimento)
# ====================================
DEBUG=false
TESTING=false

# ====================================
# Performance Tuning
# ====================================
WORKERS=4
WORKER_CLASS=gevent
WORKER_CONNECTIONS=1000
KEEPALIVE=2
TIMEOUT=120

# ====================================
# Backup & Disaster Recovery
# ====================================
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups

# ====================================
# Feature Flags
# ====================================
ENABLE_CACHING=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_EXPLANATION_API=true
ENABLE_METRICS_API=true
